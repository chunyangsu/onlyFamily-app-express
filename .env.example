# 环境变量示例文件
NODE_ENV=development
PORT=3000

# ========= 数据库配置 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=only-family
DB_USER=user
DB_PASSWORD=password

# ========== JWT配置 ==========

# JWT 密钥
JWT_SECRET=jwt-secret
# JWT 过期时间
JWT_EXPIRES_IN=1h

# ======== OSS配置 ==========
# Bucket名称
OSS_BUCKET=bucket-name
# 地域ID
OSS_REGION=cn-shanghai
# 公网访问域名(Endpoint)
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com

# RAM用户AccessKeyID
OSS_ACCESS_KEY_ID=accessKeyId
# RAM用户AccessKeySecret
OSS_ACCESS_KEY_SECRET=accessKeySecret
# RAM角色ARN
OSS_ROLE_ARN=roleArn

# OSS上传文件最大限制 10MB
OSS_UPLOAD_MAX_SIZE=10485760
# OSS上传策略有效时间 60
OSS_UPLOAD_POLICY_TTL=60